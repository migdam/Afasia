# Server Configuration
HOST=0.0.0.0
PORT=8000
DEBUG=true

# Security
SECRET_KEY=your-secret-key-change-this-in-production-use-openssl-rand-hex-32
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
LOGIN_MAX_HOURS=12
COOKIE_SECURE=true
LOGIN_MAX_FAILURES=5
LOGIN_MAX_FAILURES_PER_ACCOUNT=50
LOGIN_LOCK_MINUTES=15

# Delete recordings older than this many days; 0 keeps them until deleted
RECORDING_RETENTION_DAYS=0

# Suggest a harder level after LEVEL_WINDOW sessions averaging LEVEL_UP_SCORE %
# or more, an easier one below LEVEL_DOWN_SCORE % (placeholders, pending review)
LEVEL_WINDOW=3
LEVEL_UP_SCORE=85.0
LEVEL_DOWN_SCORE=50.0

# Days off in a row that don't break a streak (placeholder, pending review)
STREAK_REST_DAYS=2

# Database
DATABASE_URL=sqlite:///./aphasia_app.db
# For production: DATABASE_URL=postgresql://user:password@localhost/aphasia_db

# Docker Compose (docker-compose.yml) also needs SECRET_KEY above
POSTGRES_PASSWORD=change-this-database-password
# Host ports (defaults: 3000 for the app, 8000 for the API)
# FRONTEND_PORT=3000
# BACKEND_PORT=8000
# Only behind a TLS-inspecting proxy: a CA bundle for pip during the build
# PIP_CA_FILE=/etc/ssl/certs/ca-certificates.crt

# CORS Origins (comma-separated)
BACKEND_CORS_ORIGINS=http://localhost:3000,http://localhost:8000,http://127.0.0.1:3000

# File Upload
MAX_UPLOAD_SIZE=10485760
UPLOAD_DIR=./uploads
